{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tillbahrain",
  "version": "1.0.0",
  "identifier": "com.tillbahrain.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tillbahrain",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
